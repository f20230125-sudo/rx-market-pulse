# Default: guided question parser, no model calls.
RX_AGENT_PROVIDER=guided
# To use your local signed-in Claude Code: set RX_AGENT_PROVIDER=claude-cli
# CLI tools/customizations and session persistence are disabled during inference.
# RX_AGENT_MODEL=sonnet
# Hosted model option: RX_AGENT_PROVIDER=groq or gemini; set an explicit model ID
# RX_AGENT_MODEL=your-model-id
# GROQ_API_KEY=
# GEMINI_API_KEY=
