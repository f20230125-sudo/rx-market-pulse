table fact_change
	lineageTag: 9fa9ef98-424f-539d-9d77-c6acbad5d07d

	measure 'Plans losing a strength' = VAR b=SELECTEDVALUE(dim_brand[brand],"BELSOMRA") RETURN CALCULATE(COALESCE(CALCULATE(DISTINCTCOUNT(fact_change[plan_key]),fact_change[listing_change]="Listing lost"),0),dim_brand[brand]=b)
		formatString: #,0
		displayFolder: Measures
		lineageTag: e0646aff-2e0d-50cb-85c4-f543e8ce9c18

	measure 'Plans gaining a strength' = VAR b=SELECTEDVALUE(dim_brand[brand],"BELSOMRA") RETURN CALCULATE(COALESCE(CALCULATE(DISTINCTCOUNT(fact_change[plan_key]),fact_change[listing_change]="Listing gained"),0),dim_brand[brand]=b)
		formatString: #,0
		displayFolder: Measures
		lineageTag: 23319abc-b412-5dd9-94d9-be11690baa9b

	measure 'Plans with added PA' = VAR b=SELECTEDVALUE(dim_brand[brand],"BELSOMRA") RETURN CALCULATE(COALESCE(CALCULATE(DISTINCTCOUNT(fact_change[plan_key]),fact_change[pa_added]=1),0),dim_brand[brand]=b)
		formatString: #,0
		displayFolder: Measures
		lineageTag: bfc7888d-7664-586f-afd2-15df9449b191

	measure 'Plans with added ST' = VAR b=SELECTEDVALUE(dim_brand[brand],"BELSOMRA") RETURN CALCULATE(COALESCE(CALCULATE(DISTINCTCOUNT(fact_change[plan_key]),fact_change[st_added]=1),0),dim_brand[brand]=b)
		formatString: #,0
		displayFolder: Measures
		lineageTag: b6d8ed0c-90f9-5c66-8950-e9e0f88abe32

	measure 'Comparable plans' = VAR b=SELECTEDVALUE(dim_brand[brand],"BELSOMRA") RETURN CALCULATE(CALCULATE(DISTINCTCOUNT(fact_change[plan_key]),fact_change[comparable]=1),dim_brand[brand]=b)
		formatString: #,0
		displayFolder: Measures
		lineageTag: c99f5eff-fd84-515c-8ffa-968b8eeaee64

	measure 'Comparable reported enrollment' = VAR b=SELECTEDVALUE(dim_brand[brand],"BELSOMRA") RETURN CALCULATE(SUMX(VALUES(fact_change[plan_key]),CALCULATE(MAX(fact_change[latest_enrollment]),fact_change[comparable]=1)),dim_brand[brand]=b)
		formatString: #,0
		displayFolder: Measures
		lineageTag: 10468b8c-d87b-573e-8d99-980df20aff03

	measure 'Enrollment with listing lost' = VAR b=SELECTEDVALUE(dim_brand[brand],"BELSOMRA") RETURN CALCULATE(COALESCE(SUMX(VALUES(fact_change[plan_key]),CALCULATE(MAX(fact_change[latest_enrollment]),fact_change[listing_change]="Listing lost")),0),dim_brand[brand]=b)
		formatString: #,0
		displayFolder: Measures
		lineageTag: 62ddbe9e-ebff-5f49-b23b-13c76f4fa937

