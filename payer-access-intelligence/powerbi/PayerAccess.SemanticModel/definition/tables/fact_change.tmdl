	partition fact_change = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_change.csv"), [Delimiter=",", Columns=30, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"plan_key", type text}, {"brand", type text}, {"strength_mg", Int64.Type}, {"strength_key", type text}, {"baseline_month", type text}, {"latest_month", type text}, {"baseline_listing", type text}, {"latest_listing", type text}, {"baseline_pa", type text}, {"latest_pa", type text}, {"baseline_st", type text}, {"latest_st", type text}, {"baseline_ql", type text}, {"latest_ql", type text}, {"baseline_tiers", type text}, {"latest_tiers", type text}, {"baseline_ql_details", type text}, {"latest_ql_details", type text}, {"latest_enrollment", Int64.Type}, {"region", type text}, {"listing_change", type text}, {"pa_added", Int64.Type}, {"st_added", Int64.Type}, {"ql_added", Int64.Type}, {"tier_changed", Int64.Type}, {"comparable", Int64.Type}, {"baseline_formulary_id", type text}, {"latest_formulary_id", type text}, {"baseline_source_row", Int64.Type}, {"latest_source_row", Int64.Type}}, "en-US")
