	partition mart_quality = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "mart_quality.csv"), [Delimiter=",", Columns=5, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"check_id", type text}, {"check_name", type text}, {"severity", type text}, {"status", type text}, {"detail", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
