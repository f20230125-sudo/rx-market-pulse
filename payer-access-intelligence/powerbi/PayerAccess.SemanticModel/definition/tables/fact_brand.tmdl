table fact_brand
	lineageTag: bb80f8c2-085b-5bb2-ad9f-8f21df9d7288

	measure 'Selected brand' = SELECTEDVALUE(dim_brand[brand],"BELSOMRA")
		formatString: @
		displayFolder: Measures
		lineageTag: 17ef3862-2cbe-5639-9487-ed92009e3eec

	measure 'Selected snapshot' = SELECTEDVALUE(dim_snapshot[month],MAXX(ALL(dim_snapshot),dim_snapshot[month]))
		formatString: @
		displayFolder: Measures
		lineageTag: 2ef2834e-c6d8-56f4-a8cf-9acbcfedafd3

	measure Plans = VAR m=SELECTEDVALUE(dim_snapshot[month],MAXX(ALL(dim_snapshot),dim_snapshot[month])) VAR b=SELECTEDVALUE(dim_brand[brand],"BELSOMRA") RETURN CALCULATE(COUNTROWS(fact_brand),dim_snapshot[month]=m,dim_brand[brand]=b)
		formatString: #,0
		displayFolder: Measures
		lineageTag: d0ac8e2d-d76a-5a04-aeac-e047a652a0ba

	measure 'Known access plans' = VAR m=SELECTEDVALUE(dim_snapshot[month],MAXX(ALL(dim_snapshot),dim_snapshot[month])) VAR b=SELECTEDVALUE(dim_brand[brand],"BELSOMRA") RETURN CALCULATE(CALCULATE(COUNTROWS(fact_brand),fact_brand[listing]<>"Unknown"),dim_snapshot[month]=m,dim_brand[brand]=b)
		formatString: #,0
		displayFolder: Measures
		lineageTag: a165d4a4-0cec-569d-bc20-34d06b72b84c

	measure 'Listed plans' = VAR m=SELECTEDVALUE(dim_snapshot[month],MAXX(ALL(dim_snapshot),dim_snapshot[month])) VAR b=SELECTEDVALUE(dim_brand[brand],"BELSOMRA") RETURN CALCULATE(CALCULATE(COUNTROWS(fact_brand),fact_brand[listing]="Listed"),dim_snapshot[month]=m,dim_brand[brand]=b)
		formatString: #,0
		displayFolder: Measures
		lineageTag: cbbb03f6-c577-5c5a-aaa0-32382ce93d7e

	measure 'All strengths listed' = VAR m=SELECTEDVALUE(dim_snapshot[month],MAXX(ALL(dim_snapshot),dim_snapshot[month])) VAR b=SELECTEDVALUE(dim_brand[brand],"BELSOMRA") RETURN CALCULATE(CALCULATE(COUNTROWS(fact_brand),fact_brand[all_strengths_listed]=1),dim_snapshot[month]=m,dim_brand[brand]=b)
		formatString: #,0
		displayFolder: Measures
		lineageTag: 201a23e0-d3be-5623-91d7-34396e766295

	measure 'Unknown access plans' = [Plans]-[Known access plans]
		formatString: #,0
		displayFolder: Measures
		lineageTag: 54948153-e5cc-5734-8a18-e3a0b0d9e41b

	measure 'Plan listing rate' = DIVIDE([Listed plans],[Known access plans])
		formatString: 0.0%
		displayFolder: Measures
		lineageTag: 865b6b2f-12f4-5e52-bb16-85af09261e36

	measure 'Reported enrollment' = VAR m=SELECTEDVALUE(dim_snapshot[month],MAXX(ALL(dim_snapshot),dim_snapshot[month])) VAR b=SELECTEDVALUE(dim_brand[brand],"BELSOMRA") RETURN CALCULATE(SUM(fact_brand[enrollment]),dim_snapshot[month]=m,dim_brand[brand]=b)
		formatString: #,0
		displayFolder: Measures
		lineageTag: a437b3f5-0d82-579a-a7dc-c1e4ccdbf4dc

	measure 'Known access enrollment' = VAR m=SELECTEDVALUE(dim_snapshot[month],MAXX(ALL(dim_snapshot),dim_snapshot[month])) VAR b=SELECTEDVALUE(dim_brand[brand],"BELSOMRA") RETURN CALCULATE(CALCULATE(SUM(fact_brand[enrollment]),fact_brand[listing]<>"Unknown"),dim_snapshot[month]=m,dim_brand[brand]=b)
		formatString: #,0
		displayFolder: Measures
		lineageTag: 4e9b9f41-c098-54ae-b3c6-b1ab764edc06

	measure 'Listed enrollment' = VAR m=SELECTEDVALUE(dim_snapshot[month],MAXX(ALL(dim_snapshot),dim_snapshot[month])) VAR b=SELECTEDVALUE(dim_brand[brand],"BELSOMRA") RETURN CALCULATE(CALCULATE(SUM(fact_brand[enrollment]),fact_brand[listing]="Listed"),dim_snapshot[month]=m,dim_brand[brand]=b)
		formatString: #,0
		displayFolder: Measures
		lineageTag: a82d1263-3b35-576a-a9c6-6fe5baf74b9c

	measure 'Enrollment weighted listing' = DIVIDE(COALESCE([Listed enrollment],0),[Known access enrollment])
		formatString: 0.0%
		displayFolder: Measures
		lineageTag: 37f18381-1e24-5eff-8ebf-150f704d8ad5

	measure 'Plans with enrollment' = VAR m=SELECTEDVALUE(dim_snapshot[month],MAXX(ALL(dim_snapshot),dim_snapshot[month])) VAR b=SELECTEDVALUE(dim_brand[brand],"BELSOMRA") RETURN CALCULATE(COUNT(fact_brand[enrollment]),dim_snapshot[month]=m,dim_brand[brand]=b)
		formatString: #,0
		displayFolder: Measures
		lineageTag: 2f99ad3b-49fe-5144-b906-53884017db79

	measure 'Enrollment completeness' = DIVIDE([Plans with enrollment],[Plans])
		formatString: 0.0%
		displayFolder: Measures
		lineageTag: 90f6f887-f56a-5bdd-aec8-7aba533e75c9

	measure 'No PA or ST plans' = VAR m=SELECTEDVALUE(dim_snapshot[month],MAXX(ALL(dim_snapshot),dim_snapshot[month])) VAR b=SELECTEDVALUE(dim_brand[brand],"BELSOMRA") RETURN CALCULATE(CALCULATE(COUNTROWS(fact_brand),fact_brand[any_no_pa_st]=1),dim_snapshot[month]=m,dim_brand[brand]=b)
		formatString: #,0
		displayFolder: Measures
		lineageTag: b05dfd08-d573-5378-9edc-4c2af50a1e1b

	measure 'PA applies across listed strengths' = VAR m=SELECTEDVALUE(dim_snapshot[month],MAXX(ALL(dim_snapshot),dim_snapshot[month])) VAR b=SELECTEDVALUE(dim_brand[brand],"BELSOMRA") RETURN CALCULATE(CALCULATE(COUNTROWS(fact_brand),fact_brand[listing]="Listed",fact_brand[pa]="Yes"),dim_snapshot[month]=m,dim_brand[brand]=b)
		formatString: #,0
		displayFolder: Measures
		lineageTag: 24090aab-64a0-5b6e-8815-aa82836b9002

