	partition fact_brand = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_brand.csv"), [Delimiter=",", Columns=25, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"month", type text}, {"plan_key", type text}, {"contract_id", type text}, {"plan_id", type text}, {"plan_name", type text}, {"organization", type text}, {"formulary_id", type text}, {"region_code", Int64.Type}, {"region", type text}, {"suppressed", type text}, {"formulary_complete", Int64.Type}, {"plan_source_row", Int64.Type}, {"enrollment", Int64.Type}, {"enrollment_source_row", Int64.Type}, {"brand", type text}, {"catalog_strengths", Int64.Type}, {"listed_strengths", Int64.Type}, {"listing", type text}, {"all_strengths_listed", Int64.Type}, {"any_strength_listed", Int64.Type}, {"pa", type text}, {"st", type text}, {"ql", type text}, {"any_no_pa_st", Int64.Type}, {"indication_note", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
