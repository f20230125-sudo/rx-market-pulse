table dim_year
	lineageTag: 0b1fdb58-2e6c-5d95-b2ee-5b7fb0623940

	column year
		dataType: int64
		formatString: 0
		lineageTag: 79412086-f761-503c-85ac-38ac7eca9782
		summarizeBy: none
		sourceColumn: year

	partition dim_year = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_year.csv"), [Delimiter=",", Columns=1, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"year", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
