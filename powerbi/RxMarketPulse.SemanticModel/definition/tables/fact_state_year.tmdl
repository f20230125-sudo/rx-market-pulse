	partition fact_state_year = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_state_year.csv"), [Delimiter=",", Columns=6, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"state", type text}, {"year", Int64.Type}, {"enrollment", type number}, {"ffs_share", type number}, {"spend_usd", type number}, {"reporting", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
